{
  "name": "mostedge-tv-automation",
  "version": "0.1.0",
  "description": "Automation project for MostedgeTV (Android TV) using TypeScript and WebdriverIO",
  "private": true,
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@wdio/sync", "@wdio/mocha-framework"]
  },
  "include": ["./test/**/*.ts", "./src/**/*.ts", "wdio.conf.ts"]
}
